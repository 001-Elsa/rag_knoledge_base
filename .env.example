# 复制为 .env 后，替换所有 change-me。Docker Compose 只会把
# docker-compose.yml 明确列出的变量传入容器；本地直接运行时 Pydantic 也会读取此文件。

# ---- 必填 Secret / 外部服务 ----
LLM_API_KEY=change-me-deepseek-key
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
S3_ACCESS_KEY=rag-minio
S3_SECRET_KEY=change-me-minio-secret
DB_ADMIN_PASSWORD=change-me-db-admin
APP_DB_PASSWORD=change-me-db-app
WORKER_DB_PASSWORD=change-me-db-worker
FLOWER_BASIC_AUTH=admin:change-me-flower-password
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# ---- 对外发布 ----
# 有域名并启用 Caddy 自动 HTTPS 时填写；留空时 Caddy 仅监听 :80。
DOMAIN=
REFRESH_COOKIE_SECURE=false       # HTTPS 部署必须改为 true；纯 HTTP 调试保持 false
CORS_ORIGINS=                     # 同源部署留空；多个跨域来源用逗号分隔
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/minute
CHAT_GLOBAL_CONCURRENCY=32
CHAT_USER_CONCURRENCY=2
CHAT_SLOT_LEASE_SECONDS=600

# ---- LLM 与容错 ----
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
# 按所用模型价格填写（美元/百万 Token），统计页据此估算单次与累计成本。
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
BREAKER_FAIL_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30

# 备用模型（任意 OpenAI 兼容服务；三项留空表示关闭）
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# ---- 上传、切片与检索 ----
MAX_UPLOAD_MB=20
MAX_DOCUMENT_PAGES=500
MAX_UNCOMPRESSED_MB=100
MAX_SPREADSHEET_ROWS=20000
WORKSPACE_STORAGE_QUOTA_MB=10240
OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng
OCR_MIN_TEXT_CHARS=40
TABLE_EXTRACTION_ENABLED=true
# 网页/API/数据库接入默认禁止内网地址；可信内网主机在这里显式列出（逗号分隔）。
EXTERNAL_SOURCE_ALLOWED_HOSTS=
EXTERNAL_SOURCE_TIMEOUT_SECONDS=20
EXTERNAL_SOURCE_MAX_ROWS=10000
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_SIZE=10000
# EMBEDDING_DIM 与 pgvector 列维度/迁移绑定，换模型时不能只改环境变量。
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNK_STRATEGY=recursive            # fixed / paragraph / recursive / section / semantic
SEMANTIC_CHUNK_THRESHOLD=0.42
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=30
RRF_K=60
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
PARENT_CHILD_ENABLED=true
GRAPH_RETRIEVAL_ENABLED=true
RULE_RERANK_ENABLED=true
LLM_RERANK_ENABLED=false
MULTI_QUERY_ENABLED=false

# ---- 对话与缓存 ----
QUERY_REWRITE_ENABLED=true
QUERY_CLEAN_ENABLED=true
QUERY_EXPANSION_ENABLED=true
HYDE_ENABLED=false
AUTO_ROUTE_ENABLED=true
# 领域术语格式：别名=标准词,别名2=标准词2
QUERY_TERM_DICTIONARY=
SUGGESTIONS_ENABLED=true
HISTORY_SUMMARY_ENABLED=true
SUMMARY_TRIGGER_MESSAGES=12
SUMMARY_KEEP_RECENT=6
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
CONTEXT_MAX_TOKENS=6000
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_COMPRESSION_MIN_CHARS=900
ADJACENT_CHUNK_WINDOW=1
LOST_IN_MIDDLE_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SAMESITE=lax
WEBSOCKET_TICKET_TTL_SECONDS=60

# ---- 证据与 Prompt Injection ----
EVIDENCE_MIN_CHUNKS=1
EVIDENCE_MIN_RRF_SCORE=0.012
CITATION_ENTAILMENT_ENABLED=false
CITATION_ENTAILMENT_FAIL_CLOSED=false
INJECTION_HIGH_RISK_ACTION=downweight   # flag / downweight / remove
INJECTION_QUARANTINE_ENABLED=false
INJECTION_QUARANTINE_RATIO=0.5
INJECTION_LLM_CHECK_ENABLED=false
PII_REDACTION_ENABLED=true

# ---- 可靠任务与保留策略 ----
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=12
OUTBOX_BASE_RETRY_SECONDS=2
ORPHAN_OBJECT_GRACE_SECONDS=86400
AUDIT_RETENTION_DAYS=365
AUDIT_ARCHIVE_BEFORE_PURGE=true
INGESTION_EMBED_BATCH_SIZE=64
RESOURCE_DELETE_MAX_RETRIES=8
INGESTION_SOFT_TIME_LIMIT_SECONDS=1500
INGESTION_HARD_TIME_LIMIT_SECONDS=1800
WORKER_METRICS_PORT=9101
WORKER_CONCURRENCY=2
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30
WORKER_DB_POOL_SIZE=10

# ---- Compose 已固定、通常无需修改 ----
# DATABASE_URL=postgresql+psycopg://rag:ragpass@localhost:5432/ragdb
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1
# AUTO_CREATE_TABLES=true          # 本地直接运行可用；Compose 固定为 false 并执行 Alembic
# STORAGE_BACKEND=local            # Compose 固定为 s3（MinIO）
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=rag-documents
# S3_REGION=us-east-1
# S3_SECURE=false

# 监控 profile：留空表示不导出 Trace；启用时使用 Collector 的 Compose 服务名。
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
