# 复制此文件为 .env 并填入真实值

# DeepSeek API Key（必填）：https://platform.deepseek.com 注册后创建
LLM_API_KEY=sk-你的DeepSeekKey

# JWT 签名密钥（生产环境务必改成随机长字符串）
JWT_SECRET=dev-secret-change-me

# 以下为可选覆盖项（不配置则用 app/config.py 中的默认值）
# DATABASE_URL=postgresql+psycopg://rag:ragpass@localhost:5432/ragdb
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1
# AUTO_CREATE_TABLES=true          # 本地开发免迁移建表；用 Alembic 时设 false
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# RETRIEVAL_TOP_K=5
# RERANK_ENABLED=false             # 交叉编码器重排（需额外下载约 1GB 模型）
# QUERY_REWRITE_ENABLED=true       # 多轮对话查询改写
# SUGGESTIONS_ENABLED=true         # 回答后生成推荐追问
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# 备用模型（多模型容灾，任意 OpenAI 兼容服务；不配则只用主模型）
# LLM_FALLBACK_API_KEY=sk-xxx
# LLM_FALLBACK_BASE_URL=https://api.siliconflow.cn/v1
# LLM_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct

# 长对话滚动摘要
# HISTORY_SUMMARY_ENABLED=true
# SUMMARY_TRIGGER_MESSAGES=12
# SUMMARY_KEEP_RECENT=6

# 生产部署（配合 --profile edge 的 Caddy 自动 HTTPS）
# DOMAIN=demo.example.com
# CORS_ORIGINS=https://your-frontend.com
