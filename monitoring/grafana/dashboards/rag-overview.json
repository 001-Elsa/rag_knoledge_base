{
  "title": "RAG 服务总览",
  "uid": "rag-overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "QPS（按接口）",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (path) (rate(http_requests_total[1m]))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP P95 延迟（秒）",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "检索耗时 P95（秒）",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_retrieval_duration_seconds_bucket[5m])))",
          "legendFormat": "retrieval p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM 首 token 延迟 P95（秒）",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_first_token_seconds_bucket[5m])))",
          "legendFormat": "first token p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "累计问答次数",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "rag_questions_total",
          "legendFormat": "questions"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "错误率（非 2xx 占比）",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status!~\"2..\"}[5m])) / sum(rate(http_requests_total[5m]))",
          "legendFormat": "error ratio"
        }
      ]
    }
  ]
}
